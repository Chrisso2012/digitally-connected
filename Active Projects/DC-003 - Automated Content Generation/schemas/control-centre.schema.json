{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitallyconnected.net/schemas/dc-003/control-centre.schema.json",
  "title": "Control Centre Read Model",
  "description": "DC-003-I024, extended by DC-003-I025 — the in-memory operational read model assembled by control-centre-service.mjs from existing stores (Finished Carousel Store I015, Production Metrics Store I023, Publisher Result Store I025, and, when supplied, the Production Asset Export I021 directory convention). Never persisted — rebuilt fresh on every call. Two shapes, discriminated by `kind`: an `overview` (system health + dashboard totals + recent jobs + recent activity, what the CLI's `dashboard`/`jobs`/`activity`/`health` subcommands slice into) and a `job_detail` (one carousel's full generation/rendering/approval/export/publishing/metrics picture, what `job <carouselId>` returns). As of I025, `published`/`publishing` are reported from the Publisher Result Store (repository evidence of an actual completed publish), not the disconnected DC-003-I014 approval-lifecycle field I024 originally had to fall back on.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "generated_at", "health", "dashboard", "recent_jobs", "recent_activity", "engineering", "bridge", "delivery_office", "strategy_review"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "overview" },
        "generated_at": { "type": "string", "format": "date-time" },
        "health": { "$ref": "#/$defs/healthReport" },
        "dashboard": { "$ref": "#/$defs/dashboardSummary" },
        "recent_jobs": { "type": "array", "items": { "$ref": "#/$defs/jobSummary" } },
        "recent_activity": { "type": "array", "items": { "$ref": "#/$defs/activityEntry" } },
        "engineering": { "$ref": "#/$defs/engineeringSummary" },
        "bridge": { "$ref": "#/$defs/bridgeSummary" },
        "delivery_office": { "$ref": "#/$defs/deliveryOfficeSummary" },
        "strategy_review": { "$ref": "#/$defs/strategyReviewSummary" }
      }
    },
    {
      "type": "object",
      "required": ["kind", "generated_at", "job"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "job_detail" },
        "generated_at": { "type": "string", "format": "date-time" },
        "job": { "$ref": "#/$defs/jobDetail" }
      }
    }
  ],
  "$defs": {
    "healthCheck": {
      "type": "object",
      "description": "One repository-evidence-only health signal. `status` is never derived from a network call or provider ping.",
      "required": ["status", "detail", "last_success_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["ok", "warning", "unknown"] },
        "detail": { "type": "string" },
        "last_success_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "healthReport": {
      "type": "object",
      "required": [
        "anthropic",
        "templated",
        "export",
        "google_drive",
        "finished_carousel_store",
        "production_metrics_store",
        "publisher_result_store",
        "overall"
      ],
      "additionalProperties": false,
      "properties": {
        "anthropic": { "$ref": "#/$defs/healthCheck" },
        "templated": { "$ref": "#/$defs/healthCheck" },
        "export": { "$ref": "#/$defs/healthCheck" },
        "google_drive": { "$ref": "#/$defs/healthCheck" },
        "finished_carousel_store": { "$ref": "#/$defs/healthCheck" },
        "production_metrics_store": { "$ref": "#/$defs/healthCheck" },
        "publisher_result_store": { "$ref": "#/$defs/healthCheck" },
        "overall": { "type": "string", "enum": ["healthy", "warning", "attention_required"] }
      }
    },
    "costSummary": {
      "type": "object",
      "description": "An aggregate estimated cost across zero or more Production Metrics Records. `records_counted: 0` distinguishes \"no metrics recorded yet\" from a genuine zero cost.",
      "required": ["currency", "amount", "records_counted"],
      "additionalProperties": false,
      "properties": {
        "currency": { "type": ["string", "null"] },
        "amount": { "type": "number", "minimum": 0 },
        "records_counted": { "type": "integer", "minimum": 0 }
      }
    },
    "durationSummary": {
      "type": "object",
      "required": ["average_ms", "records_counted"],
      "additionalProperties": false,
      "properties": {
        "average_ms": { "type": ["number", "null"] },
        "records_counted": { "type": "integer", "minimum": 0 }
      }
    },
    "dashboardSummary": {
      "type": "object",
      "required": [
        "completed",
        "failed",
        "partial",
        "awaiting_approval",
        "approved",
        "rejected",
        "exported",
        "published",
        "today",
        "estimated_cost",
        "average_duration"
      ],
      "additionalProperties": false,
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "awaiting_approval": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "exported": {
          "description": "null when no exportsRootDir was supplied to the Control Centre — export status was never checked, not zero.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "published": { "type": "integer", "minimum": 0 },
        "today": {
          "type": "object",
          "required": ["produced_count", "estimated_cost"],
          "additionalProperties": false,
          "properties": {
            "produced_count": { "type": "integer", "minimum": 0 },
            "estimated_cost": { "$ref": "#/$defs/costSummary" }
          }
        },
        "estimated_cost": { "$ref": "#/$defs/costSummary" },
        "average_duration": { "$ref": "#/$defs/durationSummary" },
        "social_analytics": {
          "description": "DC-003-I028 — null when no Social Analytics Store was supplied to the Control Centre (never checked, not zero). counts are scoped to the same bounded 'recent' window every other dashboard total uses.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["instagram", "linkedin"],
              "additionalProperties": false,
              "properties": {
                "instagram": { "$ref": "#/$defs/platformDashboardSocial" },
                "linkedin": { "$ref": "#/$defs/platformDashboardSocial" }
              }
            }
          ]
        }
      }
    },
    "platformDashboardSocial": {
      "type": "object",
      "required": ["posts_published", "posts_with_analytics"],
      "additionalProperties": false,
      "properties": {
        "posts_published": { "type": "integer", "minimum": 0 },
        "posts_with_analytics": { "type": "integer", "minimum": 0 }
      }
    },
    "jobSummary": {
      "type": "object",
      "required": [
        "carousel_id",
        "topic_id",
        "execution_id",
        "overall_status",
        "completed_at",
        "approval_status",
        "export_status",
        "published",
        "estimated_cost",
        "duration_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "carousel_id": { "type": "string", "pattern": "^car_[A-Za-z0-9]+$" },
        "topic_id": { "type": "string" },
        "execution_id": { "type": "string" },
        "overall_status": { "type": "string", "enum": ["completed", "partial", "failed"] },
        "completed_at": { "type": "string", "format": "date-time" },
        "approval_status": { "type": "string", "enum": ["awaiting_approval", "approved", "rejected"] },
        "export_status": { "type": "string", "enum": ["exported", "not_exported", "unknown"] },
        "published": { "type": "boolean" },
        "estimated_cost": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["amount", "currency"],
              "additionalProperties": false,
              "properties": {
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string" }
              }
            }
          ]
        },
        "duration_ms": { "type": ["number", "null"] }
      }
    },
    "activityEntry": {
      "type": "object",
      "required": ["timestamp", "event", "carousel_id", "topic_id", "detail"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "event": { "type": "string", "enum": ["generated", "rendered", "approved", "exported", "published"] },
        "carousel_id": { "type": "string", "pattern": "^car_[A-Za-z0-9]+$" },
        "topic_id": { "type": "string" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "jobExport": {
      "oneOf": [
        {
          "type": "null",
          "description": "No exportsRootDir was supplied to the Control Centre — export status was never checked."
        },
        {
          "type": "object",
          "required": ["exported", "export_path", "asset_package_id", "export_timestamp"],
          "additionalProperties": false,
          "properties": {
            "exported": { "type": "boolean" },
            "export_path": { "type": ["string", "null"] },
            "asset_package_id": { "type": ["string", "null"] },
            "export_timestamp": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      ]
    },
    "jobPublishing": {
      "type": "object",
      "description": "DC-003-I025, extended by DC-003-I027 — sourced entirely from the Publisher Result Store, the repository's authoritative record of successful publications. `published` is true only when at least one Publisher Result exists for this carousel_id; `publisher_results` lists every one found (ordered oldest to newest — a carousel can legitimately be re-published, or published to more than one provider), each embedded whole and re-validated against publisher-result.schema.json. `by_provider` (DC-003-I027) breaks that same evidence down per platform, since the general `published` flag alone cannot distinguish 'published to Google Drive' from 'published to Instagram' once more than one provider exists. No heuristics, no live provider/social-platform queries — only repository evidence, per the I025/I027 briefs.",
      "required": ["published", "publisher_results", "by_provider"],
      "additionalProperties": false,
      "properties": {
        "published": { "type": "boolean" },
        "publisher_results": {
          "type": "array",
          "items": { "$ref": "https://digitallyconnected.net/schemas/dc-003/publisher-result.schema.json" }
        },
        "by_provider": {
          "type": "object",
          "description": "One entry per currently-implemented publisher provider — google_drive (I022), instagram (I027), linkedin (I027). A future provider would need its own future milestone to extend this breakdown; the underlying `publisher_results` array is already provider-neutral and needs no change.",
          "required": ["google_drive", "instagram", "linkedin"],
          "additionalProperties": false,
          "properties": {
            "google_drive": { "type": "string", "enum": ["completed", "not_recorded"] },
            "instagram": { "type": "string", "enum": ["completed", "not_recorded"] },
            "linkedin": { "type": "string", "enum": ["completed", "not_recorded"] }
          }
        }
      }
    },
    "socialPerformance": {
      "description": "DC-003-I028 — null when no Social Analytics Store was supplied to the Control Centre (analytics were never checked, not 'not collected'). Sourced ENTIRELY from the Social Analytics Store — no Meta/LinkedIn request of any kind.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["instagram", "linkedin"],
          "additionalProperties": false,
          "properties": {
            "instagram": { "$ref": "#/$defs/platformSocialPerformance" },
            "linkedin": { "$ref": "#/$defs/platformSocialPerformance" }
          }
        }
      ]
    },
    "platformSocialPerformance": {
      "type": "object",
      "required": ["collected", "latest_snapshot"],
      "additionalProperties": false,
      "properties": {
        "collected": { "type": "boolean" },
        "latest_snapshot": {
          "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/social-analytics-snapshot.schema.json" }]
        }
      }
    },
    "jobDetail": {
      "type": "object",
      "required": ["carousel_id", "topic_id", "finished_carousel", "metrics", "export", "publishing", "social_performance"],
      "additionalProperties": false,
      "properties": {
        "carousel_id": { "type": "string", "pattern": "^car_[A-Za-z0-9]+$" },
        "topic_id": { "type": "string" },
        "finished_carousel": { "$ref": "https://digitallyconnected.net/schemas/dc-003/finished-carousel.schema.json" },
        "metrics": {
          "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/production-metrics.schema.json" }]
        },
        "export": { "$ref": "#/$defs/jobExport" },
        "publishing": { "$ref": "#/$defs/jobPublishing" },
        "social_performance": { "$ref": "#/$defs/socialPerformance" }
      }
    },
    "engineeringSummary": {
      "description": "DC-003-I029 — sourced entirely from the Engineering Work Order Store and Engineering Delivery Report Store, read-only, no store ever modified by the Control Centre. Read-only, additive, optional like `socialPerformance`/`social_analytics` (DC-003-I028) — null when no Engineering stores were supplied, never a guessed/zero value.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["current_milestone", "last_completed_milestone", "outstanding_work_orders", "awaiting_review", "repository_status", "latest_delivery_report"],
          "additionalProperties": false,
          "properties": {
            "current_milestone": { "type": ["string", "null"] },
            "last_completed_milestone": { "type": ["string", "null"] },
            "outstanding_work_orders": { "type": "integer", "minimum": 0 },
            "awaiting_review": { "type": "integer", "minimum": 0 },
            "repository_status": {
              "description": "The latest Delivery Report's own commit/push_status/working_tree — never a live `git` call. null only when no Delivery Report has ever been recorded.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["commit", "push_status", "working_tree"],
                  "additionalProperties": false,
                  "properties": {
                    "commit": { "type": ["string", "null"] },
                    "push_status": { "type": "string", "enum": ["pushed", "not_pushed", "not_applicable"] },
                    "working_tree": { "type": "string", "enum": ["clean", "dirty"] }
                  }
                }
              ]
            },
            "latest_delivery_report": {
              "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/engineering-delivery-report.schema.json" }]
            }
          }
        }
      ]
    },
    "deliveryOfficeSummary": {
      "description": "DC-003-I029.2 — sourced entirely from the Engineering Work Order Store, the Engineering Delivery Report Store, and (when supplied) the Execution Lock directory. Read-only, additive, optional, paired with the SAME Engineering store pair engineeringSummary already requires — null when that pair was never supplied. No Claude Code invocation of any kind occurs from the Control Centre.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["queued_work_orders", "running_work_order", "last_delivery_report", "awaiting_review", "failed_executions", "lock_status", "runner_availability"],
          "additionalProperties": false,
          "properties": {
            "queued_work_orders": { "type": "integer", "minimum": 0 },
            "running_work_order": { "type": ["string", "null"], "pattern": "^wo_[A-Za-z0-9]+$" },
            "last_delivery_report": {
              "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/engineering-delivery-report.schema.json" }]
            },
            "awaiting_review": { "type": "integer", "minimum": 0 },
            "failed_executions": { "type": "integer", "minimum": 0 },
            "lock_status": {
              "type": "object",
              "description": "checked is false when no Execution Lock directory was supplied to the Control Centre — active/stale_locks are honestly 0 (unknown), never guessed.",
              "required": ["checked", "active_locks", "stale_locks"],
              "additionalProperties": false,
              "properties": {
                "checked": { "type": "boolean" },
                "active_locks": { "type": "integer", "minimum": 0 },
                "stale_locks": { "type": "integer", "minimum": 0 }
              }
            },
            "runner_availability": {
              "type": "object",
              "description": "A structural signal only (an invocation mechanism exists) — never a live authentication check. See delivery-office-runner-config.mjs.",
              "required": ["configured", "mechanism"],
              "additionalProperties": false,
              "properties": {
                "configured": { "type": "boolean" },
                "mechanism": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "strategyReviewSummary": {
      "description": "DC-003-I029.3 — sourced from the Engineering Strategy Review Store (standalone — decision counts need only this store) and, when the Engineering Work Order/Delivery Report pair is ALSO supplied, from Engineering Work Management for reviews_awaiting_execution. Read-only, additive, optional. No OpenAI invocation of any kind occurs from the Control Centre.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["reviews_awaiting_execution", "review_currently_locked", "latest_review", "approved_deliveries", "corrections_required", "ceo_decisions_required", "rejected_deliveries", "reviewer_availability"],
          "additionalProperties": false,
          "properties": {
            "reviews_awaiting_execution": {
              "description": "null when the Engineering Work Order/Delivery Report pair was not supplied — never checked, never a guessed zero.",
              "type": ["integer", "null"],
              "minimum": 0
            },
            "review_currently_locked": {
              "description": "null when either nothing is locked or no review lock directory was supplied.",
              "type": ["string", "null"],
              "pattern": "^dr_[A-Za-z0-9]+$"
            },
            "latest_review": {
              "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/engineering-strategy-review.schema.json" }]
            },
            "approved_deliveries": { "type": "integer", "minimum": 0 },
            "corrections_required": { "type": "integer", "minimum": 0 },
            "ceo_decisions_required": { "type": "integer", "minimum": 0 },
            "rejected_deliveries": { "type": "integer", "minimum": 0 },
            "reviewer_availability": {
              "type": "object",
              "required": ["configured", "mechanism"],
              "additionalProperties": false,
              "properties": {
                "configured": { "type": "boolean" },
                "mechanism": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "bridgeSummary": {
      "description": "DC-003-I029.1 — sourced entirely from the Bridge Transport Store, read-only, no store ever modified by the Control Centre and no networking of any kind. null when no Bridge Transport Store was supplied.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["pending_exports", "pending_imports", "history_count", "last_transport", "healthy"],
          "additionalProperties": false,
          "properties": {
            "pending_exports": { "type": "integer", "minimum": 0 },
            "pending_imports": { "type": "integer", "minimum": 0 },
            "history_count": { "type": "integer", "minimum": 0 },
            "last_transport": {
              "oneOf": [{ "type": "null" }, { "$ref": "https://digitallyconnected.net/schemas/dc-003/bridge-transport-record.schema.json" }]
            },
            "healthy": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
