# DC-003 — Automated Content Generation
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Template IDs are NOT here — they are not secrets and live in version-controlled
# config/templates.json instead. See README "Deviations from DC-003-T001" for why.

# --- LLM provider (content generation) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Templated (rendering — API key reused from DC-002, template IDs are not secrets) ---
TEMPLATED_API_KEY=
TEMPLATED_POLL_INTERVAL_MS=2000
TEMPLATED_POLL_TIMEOUT_MS=30000

# --- Runtime ---
ENVIRONMENT=production
