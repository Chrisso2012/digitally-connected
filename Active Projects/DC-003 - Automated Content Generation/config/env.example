# DC-003 — Automated Content Generation
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Template IDs are NOT here — they are not secrets and live in version-controlled
# config/templates.json instead. See README "Deviations from DC-003-T001" for why.

# --- LLM provider (content generation — DC-003-I019: real Anthropic
# provider available behind the existing provider abstraction; the mock
# provider remains the default everywhere unless a caller explicitly
# injects this one, e.g. via --live on generate-live-carousel.mjs) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_API_BASE_URL=https://api.anthropic.com/v1
LLM_REQUEST_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=3

# --- Templated (rendering — API key reused from DC-002, template IDs are not secrets) ---
TEMPLATED_API_KEY=
TEMPLATED_API_BASE_URL=https://api.templated.io/v1
TEMPLATED_REQUEST_TIMEOUT_MS=15000
TEMPLATED_RENDER_MAX_ATTEMPTS=3
# Reserved for a future polling milestone (DC-003-I006 does not poll —
# it returns whatever status Templated's render call responds with).
TEMPLATED_POLL_INTERVAL_MS=2000
TEMPLATED_POLL_TIMEOUT_MS=30000

# --- Google Drive (publishing — DC-003-I022: uploads an already-completed
# I021 export package; no Google credential existed anywhere in this
# repository or in the n8n environment's own credential store before I022
# — confirmed via repository investigation, not assumed) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com
GOOGLE_DRIVE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_DRIVE_REQUEST_TIMEOUT_MS=15000
GOOGLE_DRIVE_MAX_ATTEMPTS=3

# --- Production cost accounting (DC-003-I023: estimated costs only, from
# configured rates — never a real provider invoice. Values below are
# EXAMPLES for local testing, not authoritative current prices; check each
# provider's own current pricing page before using this for anything
# resembling a real budget) ---
ANTHROPIC_INPUT_COST_PER_MILLION_TOKENS=3.00
ANTHROPIC_OUTPUT_COST_PER_MILLION_TOKENS=15.00
TEMPLATED_COST_PER_RENDER=0.05
GOOGLE_DRIVE_COST_PER_UPLOAD=0
PRODUCTION_COST_CURRENCY=USD

# --- Windows Production Asset Export (DC-003-I026: a second, human-facing
# delivery copy of an already-completed I021 archive package, into a
# Windows-visible folder bind-mounted into the container. Both values below
# are CONTAINER-VISIBLE paths — the real Windows host folder is Docker
# infrastructure configuration (a `docker run -v <hostPath>:/data/production-assets`
# bind mount), never committed here or anywhere in source. Both have
# built-in defaults matching this project's own established container-path
# conventions; only set these if your deployment genuinely differs.) ---
PRODUCTION_ASSET_ARCHIVE_ROOT=/home/node/.n8n/dc003/exports
WINDOWS_PRODUCTION_DELIVERY_ROOT=/data/production-assets

# --- Runtime ---
ENVIRONMENT=production
